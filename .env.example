# ==============================================================================
# TravelTrip World — Production Environment Configuration
# ==============================================================================

PORT=8000
FLASK_SECRET_KEY=change_this_to_a_secure_random_string_32_chars
ENVIRONMENT=production
SITE_URL=https://traveltrip.world

# ------------------------------------------------------------------------------
# 1. Wholesale eSIM Supplier API (ResellPortal / eSIMAccess)
# ------------------------------------------------------------------------------
RESELLPORTAL_BASE_URL=https://panel.resellportal.com/wp-json/resellportal/v1
RESELLPORTAL_API_KEY=your_resellportal_api_key_here
RESELLPORTAL_API_SECRET=your_resellportal_api_secret_here
DEFAULT_SMDP=rsp.esimaccess.com

# ------------------------------------------------------------------------------
# 2. Payment Gateways (PayPal & Stripe)
# ------------------------------------------------------------------------------
# PayPal: Set PAYPAL_MODE to 'live' for real payments, or 'sandbox' for testing
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your_live_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_live_paypal_secret_here

# Stripe: Credit card, Apple Pay, Google Pay
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 (1-Click Traveler Sign-In)
# Authorized redirect URI: https://traveltrip.world/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 4. Database Connection (PostgreSQL for Vercel / SQLite for VPS)
# For persistent cloud storage on Vercel, supply a Supabase or Neon PostgreSQL URL:
# postgresql://postgres:[password]@[host]:5432/[database]
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. Email Delivery Service (eSIM QR Code & Password Resets)
# Option A: SMTP (Hostinger, Zoho, Google Workspace, AWS SES)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@traveltrip.world
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=TravelTrip World <support@traveltrip.world>

# Option B: Resend REST API (alternative to SMTP)
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 6. Sentry Crash & Error Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 7. Telegram 24/7 Cloud Alert Bot (Notifications to Admin)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 8. Site Health Monitor
# ------------------------------------------------------------------------------
CATALOG_URL=https://traveltrip.world/catalog/esim/packages?location=EU
MONITOR_INTERVAL=60
