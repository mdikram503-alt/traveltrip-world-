# TravelTrip Server — Environment Configuration
PORT=8000
FLASK_SECRET_KEY=change_this_to_a_secure_random_string_32_chars

# Wholesale eSIM Supplier API
SUPPLIER_URL=https://esimtraveler.appserviceportal.com
SUPPLIER_API_KEY=your_wholesale_api_key_here
DEFAULT_SMDP=rsp.esimaccess.com

# Payment Gateway (PayPal / Stripe)
PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=your_paypal_secret_here

# Site URL for Health Monitor
SITE_URL=https://traveltrip.world
CATALOG_URL=https://traveltrip.world/catalog/esim/packages?location=EU
MONITOR_INTERVAL=60
