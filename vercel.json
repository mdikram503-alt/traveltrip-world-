{
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/pages/(.*)", "dest": "/public/pages/$1" },
    { "src": "/downloads/(.*)", "dest": "/public/downloads/$1" },
    { "src": "/(.*)", "dest": "server.py" }
  ]
}
