    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/catalog/(.*)",
      "destination": "/api"
    },
    {
      "source": "/checkout/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
