{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/destinations",
      "destination": "/#esim-store",
      "permanent": false
    },
    {
      "source": "/destinations.html",
      "destination": "/#esim-store",
      "permanent": false
    },
    {
      "source": "/social.html",
      "destination": "/social",
      "permanent": true
    },
    {
      "source": "/packages",
      "destination": "/#esim-store",
      "permanent": true
    },
    {
      "source": "/esim-bangladesh",
      "destination": "/esim/bangladesh",
      "permanent": true
    },
    {
      "source": "/esim-india",
      "destination": "/esim/india",
      "permanent": true
    },
    {
      "source": "/esim-oman",
      "destination": "/esim/oman",
      "permanent": true
    },
    {
      "source": "/esim-pakistan",
      "destination": "/esim/pakistan",
      "permanent": true
    },
    {
      "source": "/esim-qatar",
      "destination": "/esim/qatar",
      "permanent": true
    },
    {
      "source": "/esim-uae",
      "destination": "/esim/uae",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html",
      "permanent": false
    },
    {
      "source": "/checkout/(.*)",
      "destination": "/checkout.html",
      "permanent": false
    },
    {
      "source": "/store",
      "destination": "/destinations.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/orders",
      "destination": "/account.html"
    },
    {
      "source": "/esims",
      "destination": "/account.html"
    },
    {
      "source": "/my-esims",
      "destination": "/account.html"
    },
    {
      "source": "/esim/:slug",
      "destination": "/esim/:slug.html"
    },
    {
      "source": "/api/telegram-bot",
      "destination": "/api/telegram-bot.js"
    },
    {
      "source": "/api/auto-post-all",
      "destination": "/api/auto-post-all.js"
    },
    {
      "source": "/post",
      "destination": "/post.html"
    },
    {
      "source": "/auto-post",
      "destination": "/post.html"
    },
    {
      "source": "/social",
      "destination": "/social.html"
    },
    {
      "source": "/create-payment-intent",
      "destination": "/api"
    },
    {
      "source": "/create-paypal-order",
      "destination": "/api"
    },
    {
      "source": "/flights",
      "destination": "/api"
    },
    {
      "source": "/hotels",
      "destination": "/api"
    },
    {
      "source": "/tours",
      "destination": "/api"
    },
    {
      "source": "/visa",
      "destination": "/api"
    },
    {
      "source": "/wallet",
      "destination": "/api"
    },
    {
      "source": "/vip",
      "destination": "/api"
    },
    {
      "source": "/membership",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/catalog/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(css|js|images|downloads|gallery)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}